{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true
  },
  "include": ["**/*.ts", "config/db.ts", "middleware/auth.js", "inngest/index.js", "config/nodeMailer.js"],
  "exclude": ["node_modules", "dist"]
}